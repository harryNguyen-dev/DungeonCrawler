/* Nền vũ trụ toàn màn — Background_Uni (deep space) */
.lobby-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    flex-direction: column;
    background-image: url("project://database/Assets/Art/Sprites/Background_Uni.png?fileID=2800000&guid=9db2e778e20957241ac4b48645902576&type=3#Background_Uni");
    -unity-background-scale-mode: scale-and-crop;
}

/* Lớp phủ tối nhẹ để chữ neon nổi bật trên nebula */
.lobby-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 22, 0.42);
    picking-mode: ignore;
}

.lobby-top-bar {
    position: relative;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 28px 36px 0 36px;
    min-height: 140px;
}

.top-left-container {
    align-items: flex-start;
}

.quick-access-button {
    min-width: 280px;
    min-height: 96px;
    padding: 16px 24px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    background-color: rgba(12, 28, 52, 0.88);
    border-width: 2px;
    border-color: rgb(0, 220, 255);
    border-radius: 10px;
    cursor: link;
}

.quick-access-button:hover {
    background-color: rgba(20, 48, 88, 0.95);
    border-color: rgb(120, 255, 255);
    scale: 1.02 1.02;
}

.quick-access-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 255, 255);
    margin-bottom: 4px;
}

.quick-access-subtitle {
    font-size: 14px;
    color: rgb(200, 220, 255);
}

.top-right-container {
    align-items: flex-end;
    padding: 14px 18px;
    background-color: rgba(8, 14, 32, 0.88);
    border-width: 2px;
    border-color: rgba(180, 100, 255, 0.55);
    border-radius: 10px;
    min-width: 320px;
}

.player-name-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 245, 255);
    -unity-text-align: upper-right;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.player-resources-row {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-end;
}

.resource-chip {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-width: 2px;
    border-radius: 8px;
    margin-left: 10px;
    min-width: 132px;
}

.resource-chip--gold {
    background-color: rgba(48, 36, 8, 0.92);
    border-color: rgb(255, 200, 60);
}

.resource-chip--progress {
    background-color: rgba(12, 28, 52, 0.92);
    border-color: rgb(0, 200, 255);
}

.resource-icon {
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 10px;
    min-width: 22px;
    -unity-text-align: middle-center;
}

.resource-icon--gold {
    color: rgb(255, 210, 70);
}

.resource-icon--progress {
    color: rgb(120, 230, 255);
}

.resource-text-group {
    flex-direction: column;
    align-items: flex-end;
}

.resource-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(200, 215, 235, 0.85);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.resource-value {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.resource-value--gold {
    color: rgb(255, 220, 90);
}

.resource-value--progress {
    color: rgb(120, 255, 255);
}

.lobby-main {
    position: relative;
    flex-grow: 1;
    flex-direction: row;
    padding: 24px 36px 36px 36px;
}

/* Thanh menu trái — khối neon kiểu Brawlhalla (đơn giản) */
.left-menu-bar {
    width: 200px;
    flex-direction: column;
    justify-content: flex-start;
    margin-right: 32px;
}

.menu-button {
    height: 56px;
    margin-bottom: 12px;
    padding: 0 16px;
    border-width: 2px;
    border-radius: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 250, 255);
    -unity-text-align: middle-center;
    cursor: link;
}

.menu-button:hover {
    scale: 1.03 1.03;
    border-color: rgb(255, 255, 255);
}

.menu-button--levels {
    background-color: rgba(0, 140, 200, 0.85);
    border-color: rgb(0, 220, 255);
}

.menu-button--upgrade {
    background-color: rgba(120, 40, 180, 0.85);
    border-color: rgb(200, 120, 255);
}

.menu-button--credit {
    background-color: rgba(40, 120, 80, 0.85);
    border-color: rgb(100, 255, 180);
}

.menu-button--exit {
    background-color: rgba(140, 32, 48, 0.88);
    border-color: rgb(255, 90, 110);
    margin-top: 24px;
}

.center-stage {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: rgba(72, 196, 255, 0.25);
    border-radius: 12px;
    background-color: rgba(6, 12, 28, 0.35);
}

.center-stage-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    letter-spacing: 4px;
}

.center-stage-subtitle {
    font-size: 14px;
    color: rgba(170, 200, 230, 0.75);
    -unity-text-align: middle-center;
}
