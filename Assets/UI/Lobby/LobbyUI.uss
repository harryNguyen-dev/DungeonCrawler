@import url("../Shared/SciFiTheme.uss");

.lobby-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.lobby-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(13, 23, 33);
}

.lobby-ui-layer {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
}

.lobby-top-bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 28px 36px 0 36px;
    min-height: 96px;
}

.top-right-container {
    align-items: flex-end;
}

.resource-chip {
    flex-direction: column;
    align-items: flex-end;
    padding: 14px 22px 16px 22px;
    min-width: 168px;
    min-height: 72px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.resource-value-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: 4px;
}

.resource-icon {
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 8px;
    min-width: 22px;
    -unity-text-align: middle-center;
}

.resource-icon--gold {
    color: rgb(255, 210, 70);
}

.resource-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(220, 230, 245, 0.9);
    letter-spacing: 2px;
    -unity-text-align: upper-right;
}

.resource-value {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.resource-value--gold {
    color: rgb(255, 210, 90);
}

.lobby-main {
    flex-grow: 1;
    flex-direction: row;
    padding: 24px 36px 36px 36px;
}

.left-menu-bar {
    width: 340px;
    flex-direction: column;
    justify-content: flex-start;
}

.menu-button {
    min-height: 54px;
    width: 100%;
    margin-bottom: 14px;
    padding: 0 36px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(245, 248, 255);
    -unity-text-align: middle-center;
    cursor: link;
    letter-spacing: 1px;
    overflow: hidden;
}

.menu-button:disabled {
    color: rgb(200, 210, 225);
    opacity: 0.72;
}

.menu-button:hover {
    scale: 1.02 1.02;
}

.menu-button--continue {
    min-height: 58px;
}

.menu-button--exit {
    margin-top: 28px;
}

.menu-button-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(245, 248, 255);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    width: 100%;
}
