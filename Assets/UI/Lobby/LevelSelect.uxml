<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="LevelSelect.uss" />
    <ui:VisualElement name="level-select-root" class="level-select-root">
        <ui:VisualElement class="level-select-backdrop" />
        <ui:VisualElement class="level-select-panel">
            <ui:Label text="SELECT STAGE" class="level-select-title" />
            <ui:Label text="Chapter 1" class="level-select-subtitle" />
            <ui:Label name="progress-label" text="Unlocked 1/10" class="level-select-progress" />
            <ui:ScrollView name="level-scroll" class="level-scroll" />
            <ui:Button name="close-button" text="Close" class="level-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
