@import url("../Shared/SciFiTheme.uss");

.level-select-root {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.level-select-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.level-select-panel {
    position: relative;
    width: 480px;
    max-height: 82%;
}

.level-select-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(100, 220, 255);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    letter-spacing: 2px;
}

.level-select-subtitle {
    font-size: 13px;
    color: rgba(190, 210, 230, 0.9);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.level-select-progress {
    font-size: 12px;
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.level-scroll {
    flex-grow: 1;
    min-height: 320px;
    max-height: 480px;
    margin-bottom: 12px;
}

.level-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgba(12, 22, 40, 0.88);
    border-width: 2px;
    border-color: rgba(45, 110, 165, 0.55);
    border-radius: 2px;
    cursor: link;
}

.level-row:hover {
    border-color: rgba(0, 210, 255, 0.75);
    background-color: rgba(16, 32, 56, 0.92);
}

.level-row--locked {
    cursor: arrow;
    background-color: rgba(12, 22, 40, 0.55);
    border-color: rgba(45, 110, 165, 0.28);
}

.level-row--locked .level-label {
    color: rgb(175, 188, 205);
}

.level-row--locked .level-status {
    color: rgb(150, 168, 190);
}

.level-row--next {
    border-color: rgba(255, 190, 70, 0.85);
    background-color: rgba(36, 28, 12, 0.55);
}

.level-label {
    font-size: 16px;
    color: rgb(230, 240, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.level-status {
    font-size: 12px;
    color: rgb(100, 220, 255);
    -unity-font-style: bold;
}

.level-close-button {
    align-self: center;
    min-width: 140px;
    min-height: 48px;
}
