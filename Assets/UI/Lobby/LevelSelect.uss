.level-select-root {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.level-select-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.level-select-panel {
    position: relative;
    width: 420px;
    max-height: 80%;
    padding: 24px;
    background-color: rgba(10, 16, 32, 0.96);
    border-width: 1px;
    border-color: rgba(72, 196, 255, 0.55);
    border-radius: 12px;
}

.level-select-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 220, 255);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.level-select-subtitle {
    font-size: 13px;
    color: rgb(170, 190, 210);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.level-select-progress {
    font-size: 12px;
    color: rgb(255, 210, 90);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.level-scroll {
    flex-grow: 1;
    min-height: 320px;
    max-height: 480px;
    margin-bottom: 12px;
}

.level-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgba(24, 36, 56, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    cursor: link;
}

.level-row:hover {
    border-color: rgba(120, 220, 255, 0.75);
}

.level-row--locked {
    opacity: 0.45;
    cursor: arrow;
}

.level-row--next {
    border-color: rgba(255, 210, 90, 0.85);
    background-color: rgba(48, 40, 16, 0.55);
}

.level-label {
    font-size: 16px;
    color: rgb(230, 240, 255);
}

.level-status {
    font-size: 12px;
    color: rgb(120, 220, 255);
    -unity-font-style: bold;
}

.level-close-button {
    align-self: center;
    min-width: 120px;
    padding: 8px 16px;
    background-color: rgba(40, 60, 90, 0.95);
    border-color: rgba(120, 220, 255, 0.45);
    color: rgb(220, 235, 255);
}
