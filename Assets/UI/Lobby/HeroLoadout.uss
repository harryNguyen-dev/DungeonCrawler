@import url("../Shared/SciFiTheme.uss");

.hero-loadout-root {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    picking-mode: ignore;
}

.hero-loadout-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.28);
    picking-mode: ignore;
}

.hero-loadout-center {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    picking-mode: ignore;
}

.hero-loadout-shell {
    picking-mode: position;
    width: 960px;
    height: 500px;
    max-width: 92%;
    max-height: 72%;
    flex-shrink: 0;
    flex-direction: column;
}

.hero-loadout-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.hero-close-button {
    width: 32px;
    height: 26px;
    margin-right: 8px;
    font-size: 12px;
}

.hero-loadout-title {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(100, 220, 255);
    letter-spacing: 2px;
}

.hero-meta-gold {
    font-size: 14px;
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
}

.hero-loadout-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.hero-left-column {
    width: 300px;
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 12px;
    min-height: 0;
    position: relative;
}

.weapon-scroll {
    flex-grow: 1;
    min-height: 0;
}

.weapon-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgba(12, 22, 40, 0.88);
    border-width: 2px;
    border-color: rgba(45, 110, 165, 0.45);
    border-radius: 2px;
}

.weapon-row:hover {
    border-color: rgba(0, 210, 255, 0.6);
}

.weapon-row--selected {
    border-color: rgba(255, 190, 70, 0.9);
    background-color: rgba(36, 28, 12, 0.55);
}

.weapon-row--locked {
    background-color: rgba(12, 22, 40, 0.55);
    border-color: rgba(45, 110, 165, 0.28);
}

.weapon-row--locked .weapon-row-name {
    color: rgb(175, 188, 205);
}

.weapon-row--locked .weapon-row-status {
    color: rgb(150, 168, 190);
}

.weapon-row-name {
    font-size: 13px;
    color: rgb(235, 242, 255);
    -unity-font-style: bold;
    flex-shrink: 1;
    margin-right: 8px;
}

.weapon-row-status {
    font-size: 10px;
    color: rgb(100, 220, 255);
    -unity-font-style: bold;
    flex-shrink: 0;
}

.weapon-detail-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 12px;
    background-color: rgb(10, 18, 32);
    border-width: 2px;
    border-color: rgba(45, 120, 175, 0.65);
    border-radius: 2px;
    flex-direction: column;
}

.detail-header-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.detail-close-button {
    width: 28px;
    height: 24px;
    margin-left: 8px;
    flex-shrink: 0;
    font-size: 11px;
}

.detail-name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
    white-space: normal;
}

.detail-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 10px;
}

.detail-description {
    font-size: 12px;
    color: rgb(200, 215, 235);
    white-space: normal;
    margin-bottom: 8px;
}

.detail-status {
    font-size: 12px;
    color: rgb(100, 220, 255);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.detail-actions {
    flex-direction: column;
    flex-shrink: 0;
}

.detail-primary-button {
    min-height: 44px;
    margin-bottom: 8px;
    font-size: 13px;
}

.detail-equip-button {
    min-height: 44px;
    margin-bottom: 8px;
    font-size: 13px;
}

.detail-upgrade-button {
    min-height: 42px;
    margin-bottom: 6px;
    font-size: 11px;
}

.hero-preview-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgba(8, 14, 28, 0.9);
    border-radius: 2px;
    border-width: 2px;
    border-color: rgba(45, 110, 165, 0.45);
    position: relative;
}

.hero-preview-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: ignore;
}

.hero-preview-drag-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hero-preview-hint {
    position: absolute;
    bottom: 6px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: rgba(200, 220, 240, 0.65);
    picking-mode: ignore;
}
