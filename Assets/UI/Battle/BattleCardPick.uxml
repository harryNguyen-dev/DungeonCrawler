<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BattleCardPick.uss" />
    <ui:VisualElement name="card-pick-root" class="card-pick-root">
        <ui:VisualElement class="card-pick-backdrop" />
        <ui:VisualElement class="card-pick-content scifi-panel">
            <ui:Label text="CHOOSE CARD" class="card-pick-title" />
            <ui:Label text="Lv up — pick 1 upgrade" class="card-pick-subtitle" />
            <ui:VisualElement name="card-container" class="card-container" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
