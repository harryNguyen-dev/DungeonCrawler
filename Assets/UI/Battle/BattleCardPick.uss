.card-pick-root {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.card-pick-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
}

.card-pick-content {
    position: relative;
    align-items: center;
    padding: 24px 32px 32px;
    background-color: rgba(10, 16, 32, 0.94);
    border-width: 1px;
    border-color: rgba(72, 196, 255, 0.5);
    border-radius: 12px;
    max-width: 96%;
}

.card-pick-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 220, 255);
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.card-pick-subtitle {
    font-size: 13px;
    color: rgb(170, 190, 210);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.card-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
}

.card-item {
    width: 280px;
    min-height: 360px;
    margin: 8px 12px;
    padding: 16px 14px;
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(255, 255, 255, 0.15);
    cursor: link;
    transition-duration: 0.15s;
}

.card-item:hover {
    scale: 1.03 1.03;
    border-color: rgba(120, 220, 255, 0.85);
}

.card-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    white-space: normal;
}

.card-desc {
    font-size: 13px;
    white-space: normal;
    color: rgb(200, 210, 220);
}
