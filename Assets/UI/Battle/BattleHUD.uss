.battle-hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    picking-mode: Ignore;
}

.player-panel {
    picking-mode: position;
    position: absolute;
    top: 16px;
    left: 16px;
    width: 320px;
    padding: 12px 14px;
    background-color: rgba(8, 14, 28, 0.82);
    border-width: 1px;
    border-color: rgba(72, 196, 255, 0.45);
    border-radius: 8px;
}

.level-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(120, 220, 255);
    margin-bottom: 8px;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.bar-label {
    width: 36px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(190, 210, 230);
}

.bar-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    overflow: hidden;
    margin-left: 4px;
    margin-right: 8px;
}

.bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 4px;
}

.hp-fill {
    background-color: rgb(72, 220, 120);
}

.exp-fill {
    background-color: rgb(255, 196, 64);
}

.bar-value {
    min-width: 64px;
    font-size: 11px;
    color: rgb(220, 230, 240);
    -unity-text-align: middle-right;
}

.stats-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.stat-label {
    font-size: 12px;
    color: rgb(200, 215, 235);
    margin-right: 16px;
    margin-top: 2px;
}
