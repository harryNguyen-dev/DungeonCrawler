@import url("../Shared/SciFiTheme.uss");

.pause-root {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.pause-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
}

.pause-content {
    position: relative;
    width: 380px;
    max-width: 90%;
}

.pause-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(100, 220, 255);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.pause-subtitle {
    font-size: 14px;
    color: rgba(190, 210, 230, 0.9);
    margin-bottom: 22px;
    -unity-text-align: middle-center;
}

.button-row {
    flex-direction: row;
    justify-content: center;
}

.pause-btn {
    min-width: 130px;
    min-height: 48px;
    margin-left: 8px;
    margin-right: 8px;
}
