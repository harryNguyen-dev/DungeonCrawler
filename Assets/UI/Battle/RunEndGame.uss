@import url("../Shared/SciFiTheme.uss");

.run-end-root {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.run-end-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.run-end-content {
    position: relative;
    width: 520px;
    max-width: 92%;
    align-items: stretch;
}

.run-end-title {
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.win-title {
    color: rgb(120, 255, 170);
}

.lose-title {
    color: rgb(255, 110, 110);
}

.run-end-subtitle {
    font-size: 14px;
    color: rgba(190, 210, 230, 0.9);
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.run-end-section {
    margin-bottom: 14px;
    padding: 10px 12px;
    background-color: rgba(12, 22, 40, 0.65);
    border-width: 1px;
    border-color: rgba(45, 110, 165, 0.45);
    border-radius: 2px;
}

.section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(100, 220, 255);
    margin-bottom: 8px;
    letter-spacing: 2px;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-item {
    width: 48%;
    font-size: 13px;
    color: rgb(200, 215, 235);
    margin-bottom: 4px;
}

.stat-item.highlight {
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
}

.gold-section {
    align-items: center;
}

.meta-gain-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.meta-total-label {
    font-size: 13px;
    color: rgba(190, 210, 230, 0.9);
    -unity-text-align: middle-center;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.run-end-btn {
    min-width: 130px;
    min-height: 48px;
    margin-left: 8px;
    margin-right: 8px;
}
