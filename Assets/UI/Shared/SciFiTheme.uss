/* Sci-fi UI theme — metallic frames, cyan glow, yellow accents */

.scifi-panel {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 22px 24px;
}

.scifi-panel-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(100, 220, 255);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    letter-spacing: 2px;
}

.scifi-panel-subtitle {
    font-size: 13px;
    color: rgba(190, 210, 230, 0.9);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.scifi-panel-accent-text {
    font-size: 12px;
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.scifi-button {
    min-height: 48px;
    width: 100%;
    padding: 0 36px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(245, 248, 255);
    -unity-text-align: middle-center;
    cursor: link;
    letter-spacing: 0.5px;
    overflow: hidden;
}

.scifi-button:hover {
    scale: 1.02 1.02;
}

.scifi-button:disabled {
    color: rgb(200, 210, 225);
    opacity: 0.72;
}

.scifi-button-compact {
    min-width: 36px;
    min-height: 30px;
    padding: 0 8px;
    background-color: rgba(10, 20, 38, 0.92);
    border-width: 2px;
    border-color: rgb(45, 120, 175);
    border-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 235, 255);
    cursor: link;
}

.scifi-button-compact:hover {
    border-color: rgb(0, 210, 255);
    background-color: rgba(16, 36, 62, 0.95);
}

.scifi-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgba(12, 22, 40, 0.88);
    border-width: 2px;
    border-color: rgba(45, 110, 165, 0.55);
    border-radius: 2px;
    cursor: link;
}

.scifi-row:hover {
    border-color: rgba(0, 210, 255, 0.75);
    background-color: rgba(16, 32, 56, 0.92);
}

.scifi-row--locked {
    cursor: arrow;
    background-color: rgba(12, 22, 40, 0.55);
    border-color: rgba(45, 110, 165, 0.3);
}

.scifi-row--highlight {
    border-color: rgba(255, 190, 70, 0.85);
    background-color: rgba(36, 28, 12, 0.55);
}
